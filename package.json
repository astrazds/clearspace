  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "package:release": "node scripts/package.mjs",
    "check": "npm test && npm run package:release && npm run test:browser"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
