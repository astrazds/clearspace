{
  "name": "clearspace",
  "version": "0.1.0",
  "description": "Privacy-conscious cosmetic cleanup companion for Chromium",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrazds/clearspace.git"
  },
  "homepage": "https://github.com/astrazds/clearspace#readme",
  "bugs": {
    "url": "https://github.com/astrazds/clearspace/issues"
  },
  "keywords": [
    "ad-blocking",
    "browser-extension",
    "chromium",
    "cosmetic-filtering",
    "easylist",
    "manifest-v3",
    "privacy"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test:browser": "npm run package:release && node scripts/smoke.mjs",
    "package:release": "node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "esbuild": "0.28.2",
    "playwright-core": "^1.60.0",
    "typescript": "7.0.2"
  }
}
